<Window x:Class="Kaffeeplan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kaffemaschinen-Dienstplan" Height="700" Width="1100">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Jahr" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding Jahr, UpdateSourceTrigger=PropertyChanged}"
                     Width="70" VerticalAlignment="Center" />
            <Button Content="Plan erzeugen" Command="{Binding PlanErzeugenCommand}"
                    Margin="12,0,0,0" Padding="12,4" />
            <Button Content="Mitarbeiter hinzufügen" Command="{Binding MitarbeiterHinzufuegenCommand}"
                    Margin="12,0,0,0" Padding="12,4" Background="Green"/>
            <Button Content="Mitarbeiter entfernen" Command="{Binding MitarbeiterEntfernenCommand}"
                    Margin="12,0,0,0" Padding="12,4" Background="Red"/>

            <TextBlock Text="TESTZWECK" VerticalAlignment="Center" Margin="8,0,8,0" />
            <TextBox Text="{Binding neuermitarbeiter, UpdateSourceTrigger=PropertyChanged}"
         Width="70" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Hauptbereich -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0"
                      ItemsSource="{Binding Mitarbeiter}" SelectedItem="{Binding GewaehlterMitarbeiter, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mitarbeiter" Binding="{Binding Name}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="1" Margin="8,0"
                      ItemsSource="{Binding Planeintraege}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <!--Design-->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HatFiltertausch}" Value="True">
                                <Setter Property="Background" Value="#c7effc"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="KW"     Binding="{Binding Kalenderwoche}" Width="50" />
                    <DataGridTextColumn Header="Montag" Binding="{Binding MontagDatum, StringFormat=dd.MM.yyyy}" Width="100" />
                    <DataGridTextColumn Header="Person" Binding="{Binding MitarbeiterName}" Width="*" />
                    <DataGridTextColumn Header="Filter" Binding="{Binding HatFiltertausch}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>

            <DataGrid Grid.Column="2"
                      ItemsSource="{Binding Statistik}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Reinigungen" Binding="{Binding Reinigungen}" Width="*" />
                    <DataGridTextColumn Header="Filter Tausche" Binding="{Binding FilterTausche}" Width="*" />
                </DataGrid.Columns>
               
            </DataGrid>
        </Grid>

        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding Statusmeldung}" />
        </StatusBar>
    </Grid>
</Window>
